# --- Database ---
# Default SQLite (no extra setup)
DATABASE_URL=sqlite:///./mystyla.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mystyla_db

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=wardrobe

# --- CORS ---
# Comma-separated values allowed if needed
CORS_ORIGINS=http://localhost:5173

# --- Background removal ---
# Lower REMBG_MAX_SIZE to 768 or 640 if ONNX runs out of memory
REMBG_MODEL=isnet-general-use
REMBG_MAX_SIZE=1024
